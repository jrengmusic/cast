// Pass 2 of the two-pass stack blur — reads pass 1's (stack_blur_texture.comp)
// transposed output through the set-2 input SSBO, writes transposed again
// into the set-2 output SSBO, restoring the original row-major orientation
// (out[x * lineCount + line], where this pass's lineCount/lineLength are pass
// 1's lineLength/lineCount swapped).
#version 450
#extension GL_GOOGLE_include_directive : require

layout (push_constant) uniform StackBlurPC { int radius; int lineCount; int lineLength; uint sourceTextureIndex; };

layout (set = 2, binding = 0, std430) readonly buffer StackBlurInputBuffer { uint stackBlurInput[]; };
layout (set = 2, binding = 1, std430) buffer StackBlurOutputBuffer { uint stackBlurOutput[]; };

int stackBlurCurrentLine;

vec4 loadElement (int element)
{
    int clampedElement = clamp (element, 0, lineLength - 1);
    uint packed = stackBlurInput[stackBlurCurrentLine * lineLength + clampedElement];

    float blue  = float (packed & 0xffu);
    float green = float ((packed >> 8) & 0xffu);
    float red   = float ((packed >> 16) & 0xffu);
    float alpha = float ((packed >> 24) & 0xffu);

    return vec4 (red, green, blue, alpha);
}

#include "stack_blur.glsl"

// local_size_x is paired with jam::stackBlurWorkgroupSize
// (jam_VulkanStackBlurPushConstants.h) — one invocation per line, so this
// value determines VulkanGraphics::dispatchStackBlur()'s workgroup count.
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main()
{
    int line = int (gl_GlobalInvocationID.x);

    if (line < lineCount)
    {
        stackBlurCurrentLine = line;
        stackBlurLine();
    }
}
