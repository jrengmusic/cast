diff --git a/modules/juce_graphics/juce_graphics.h b/modules/juce_graphics/juce_graphics.h
--- a/modules/juce_graphics/juce_graphics.h
+++ b/modules/juce_graphics/juce_graphics.h
@@ -157,8 +157,19 @@
 #if JUCE_GRAPHICS_INCLUDE_RENDERING_HELPERS
  #include "native/juce_RenderingHelpers.h"
 #endif
 
 #if JUCE_GRAPHICS_INCLUDE_COREGRAPHICS_HELPERS && (JUCE_MAC || JUCE_IOS)
  #include "native/juce_CoreGraphicsHelpers_mac.h"
  #include "native/juce_CoreGraphicsContext_mac.h"
 #endif
+
+// JUCE_GRAPHICS_INCLUDE_COREGRAPHICS_HELPERS is defined only by this module's own .cpp
+// (and by juce_gui_basics.cpp, which raw-includes the same native headers below); excluding
+// on it stops this gate from re-including headers those .cpp files already include unguarded.
+#if JUCE_GRAPHICS_INCLUDE_DIRECT2D_HELPERS && JUCE_WINDOWS && ! JUCE_GRAPHICS_INCLUDE_COREGRAPHICS_HELPERS
+ #ifndef JUCE_DIRECT2D_GRAPHICS_CONTEXT_WINDOWS_H_INCLUDED
+  #define JUCE_DIRECT2D_GRAPHICS_CONTEXT_WINDOWS_H_INCLUDED
+  #include "native/juce_Direct2DMetrics_windows.h"
+  #include "native/juce_Direct2DGraphicsContext_windows.h"
+ #endif
+#endif
diff --git a/modules/juce_gui_basics/juce_gui_basics.h b/modules/juce_gui_basics/juce_gui_basics.h
--- a/modules/juce_gui_basics/juce_gui_basics.h
+++ b/modules/juce_gui_basics/juce_gui_basics.h
@@ -401,3 +401,14 @@
 #include "layout/juce_GridItem.h"
 #include "layout/juce_Grid.h"
 #include "native/juce_ScopedDPIAwarenessDisabler.h"
+
+// JUCE_GRAPHICS_INCLUDE_COREGRAPHICS_HELPERS is defined only by this module's own .cpp
+// (and by juce_graphics.cpp); excluding on it stops this gate from re-including a header
+// this module's .cpp already includes unguarded. Requires JUCE_CORE_INCLUDE_NATIVE_HEADERS
+// to be defined by the consumer beforehand so HWND is a known type.
+#if JUCE_GRAPHICS_INCLUDE_DIRECT2D_HELPERS && JUCE_WINDOWS && ! JUCE_GRAPHICS_INCLUDE_COREGRAPHICS_HELPERS
+ #ifndef JUCE_DIRECT2D_HWND_CONTEXT_WINDOWS_H_INCLUDED
+  #define JUCE_DIRECT2D_HWND_CONTEXT_WINDOWS_H_INCLUDED
+  #include "native/juce_Direct2DHwndContext_windows.h"
+ #endif
+#endif
