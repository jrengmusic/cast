diff --git a/modules/juce_gui_basics/native/juce_Windowing_windows.cpp b/modules/juce_gui_basics/native/juce_Windowing_windows.cpp
--- a/modules/juce_gui_basics/native/juce_Windowing_windows.cpp
+++ b/modules/juce_gui_basics/native/juce_Windowing_windows.cpp
@@ -2456,16 +2456,21 @@
     //==============================================================================
     void handlePaintMessage()
     {
         if (externalContextFactory != nullptr)
         {
+            RECT updateRect{};
+            GetUpdateRect (hwnd, &updateRect, false);
+            lastPaintUpdateRect = Rectangle<int>::leftTopRightBottom ((int) updateRect.left, (int) updateRect.top,
+                                                                       (int) updateRect.right, (int) updateRect.bottom);
+
             PAINTSTRUCT ps;
             BeginPaint (hwnd, &ps);
             if (auto ctx = externalContextFactory (*this))
                 handlePaint (*ctx);
             EndPaint (hwnd, &ps);
             lastPaintTime = Time::getMillisecondCounter();
             return;
         }
 
         if (renderContext != nullptr)
             renderContext->handlePaintMessage();
