     /** A function pointer that, if set, allows an external module to provide a custom
         LowLevelGraphicsContext for component painting. If the factory returns nullptr,
         the peer falls back to its default rendering engine.
     */
     static inline std::unique_ptr<LowLevelGraphicsContext> (*externalContextFactory) (ComponentPeer&) = nullptr;
 
+    /** The OS-reported dirty rectangle captured immediately before the native paint cycle
+        that's about to service it. Empty unless externalContextFactory is in use on Windows;
+        not populated on other platforms.
+        @see externalContextFactory
+    */
+    const Rectangle<int>& getLastPaintUpdateRect() const noexcept { return lastPaintUpdateRect; }
+
     //==============================================================================
