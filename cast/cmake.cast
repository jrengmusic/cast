```codesign
COMMAND codesign --force --options runtime --entitlements "${CMAKE_SOURCE_DIR}/:::entitlementsPath:::" --sign ":::identity:::" $<TARGET_FILE:${PROJECT_NAME}>
```

```zip
COMMAND ditto -c -k --keepParent $<TARGET_FILE:${PROJECT_NAME}> $<TARGET_FILE:${PROJECT_NAME}>.zip
```

```notarize
COMMAND xcrun notarytool submit $<TARGET_FILE:${PROJECT_NAME}>.zip --keychain-profile ":::notaryProfile:::" --wait
```

```install-directory
